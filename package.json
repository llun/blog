{
  "name": "main-blog",
  "version": "1.0.0",
  "description": "My main website and blog posts",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "yarn feeds && next build --turbopack",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "export": "yarn feeds && BLOG_EXPORT=1 next build --turbopack",
    "feeds": "yarn ride:exec scripts/generate-feeds.ts",
    "optimize-images": "scripts/optimize-images.sh",
    "ride:exec": "tsx",
    "ride": "yarn ride:exec scripts/load-netherlands-activities.ts && yarn ride:exec scripts/load-slovenia-activities.ts && yarn ride:exec scripts/simplify-gps.ts && yarn ride:exec scripts/generate-rides-stats.ts"
  },
  "author": "Maythee Anegboonlap <contact@llun.dev>",
  "license": "UNLICENSED",
  "dependencies": {
    "classnames": "^2.5.1",
    "lucide-react": "^1.59.0",
    "mapbox-gl": "^3.33.0",
    "react-modal": "^3.16.3"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@swc/core": "^1.16.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/kd-tree-javascript": "^1.0.3",
    "@types/lodash": "^4.17.26",
    "@types/luxon": "^3.7.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-modal": "^3.16.3",
    "@types/yargs": "^17.0.35",
    "axios": "^1.20.0",
    "decimal.js": "^10.6.0",
    "dotenv-flow": "^4.1.0",
    "feed": "^6.0.0",
    "kd-tree-javascript": "^1.0.3",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-implicit-figures": "^0.12.0",
    "markdown-it-link-attributes": "^4.0.1",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simplify-js": "^1.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1",
    "yargs": "^18.2.0"
  },
  "dependenciesMeta": {
    "@swc/core": {
      "built": true
    },
    "sharp": {
      "built": true
    }
  },
  "packageManager": "yarn@4.18.1"
}
